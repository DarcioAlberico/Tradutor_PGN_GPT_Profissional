.venv/
__pycache__/
*.py[cod]
*.pyo
*.db
# O indice do glossario e versionado; o cache de traducoes (80 MB) nao.
!glossario.db
*.db-journal
# Arquivos auxiliares do WAL (ver open_database, garantia C3): ficam ao lado do
# banco enquanto ele esta aberto.
*.db-wal
*.db-shm
pgn_tradutor_pro_settings.json
# As chaves de API (ROADMAP 28.7): cifradas, mas nunca no repositorio.
chaves-api.json
chaves-api.json.tmp
traducoes.db-journal
backups/
logs/

# Capturas do driver da skill de execucao: efemeras, refeitas a cada rodada.
.claude/skills/*/capturas/

# Saida do PyInstaller. A receita (`PGN_Tradutor_Pro.spec`) e versionada; o
# resultado dela, nao — sao 47 MB de binarios reconstruiveis com um comando, e
# especificos da plataforma que rodou o build.
build/
dist/

# Artefato da medicao de cobertura (coverage.py), gerado sob demanda.
.coverage

# Saida do compilador do instalador (Inno Setup). A receita
# (`instalador\PGN_Tradutor_Pro.iss`) e versionada; o `.exe` gerado, nao.
instalador/saida/

# Saida do piloto do modelo de linguagem (ROADMAP 28.7, passo 0): a amostra
# traz 200 comentarios do livro de dev — obra protegida — e as traducoes,
# folhas e gabaritos saem dela. So o script (`ferramentas/piloto_llm.py`) e
# versionado; os numeros que decidem vao para o ROADMAP.
piloto/

# Configuracao do PyCharm: e de quem usa, nao do projeto.
.idea/
